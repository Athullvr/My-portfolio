---
interface Props { kind?: 'todo' | 'confirm' }
const { kind = 'todo' } = Astro.props;
const label = kind === 'todo' ? 'TODO(athul)' : 'CONFIRM(athul)';
---

<aside class:list={['note', `note--${kind}`]}>
  <strong class="mono">{label}</strong>
  <span><slot /></span>
</aside>

<style>
  .note {
    display: grid;
    gap: var(--space-1);
    margin-block: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: 1px dashed var(--border);
    border-radius: 8px;
    font-size: var(--fs-small);
    color: var(--muted);
    max-width: var(--measure);
  }
  .note strong { font-size: var(--fs-label); letter-spacing: 0.06em; color: var(--subtle); }
  .note--confirm { border-style: solid; }
</style>
