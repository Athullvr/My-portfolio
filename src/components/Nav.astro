---
import { site, mailto } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="nav">
  <nav class="container nav__inner" aria-label="Main">
    <a class="nav__brand mono" href="/" aria-label={`${site.name}, home`}>{site.handle}</a>
    <ul class="nav__list">
      {site.nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      <li><a href={site.resume} aria-label="Resume (PDF)">Resume<span class="nav__pdf" aria-hidden="true"> (PDF)</span></a></li>
      <li><a href={mailto}>Email</a></li>
      <li class="nav__extra"><slot /></li>
      <li><ThemeToggle /></li>
    </ul>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .nav__inner { display: flex; align-items: center; justify-content: space-between; min-height: 3.5rem; gap: var(--space-4); }
  .nav__brand { color: var(--ink); text-decoration: none; font-weight: 600; font-size: var(--fs-small); }
  .nav__list { display: flex; align-items: center; gap: clamp(0.75rem, 2.5vw, 1.5rem); list-style: none; padding: 0; font-size: var(--fs-small); }
  .nav__list a { color: var(--muted); text-decoration: none; padding-block: 0.6rem; display: inline-block; }
  .nav__list a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 6px; }
  .nav__extra:empty { display: none; }
  .nav__pdf { display: none; }
  @media (min-width: 40rem) { .nav__pdf { display: inline; } }
</style>
