---
import { proof } from '../data/projects';
---

<section class="proof hero-fade" style="--i:2" aria-label="Hackathon results">
  <ul class="container proof__list">
    {proof.map((p) => (
      <li>
        <a class="proof__item" href={p.href}>
          <span class="proof__rank mono">{p.rank}</span>
          <span class="proof__text"><strong>{p.event}</strong><span>{p.meta}</span></span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .proof { border-block: 1px solid var(--border); background: var(--surface); }
  .proof__list { list-style: none; padding-block: 0; display: grid; }
  .proof__item { display: flex; align-items: center; gap: var(--space-4); padding-block: var(--space-4); color: var(--ink); text-decoration: none; }
  .proof li + li .proof__item { border-top: 1px solid var(--border); }
  .proof__rank { min-width: 4.5rem; font-size: var(--fs-small); font-weight: 600; color: var(--signal); }
  .proof__text { display: grid; line-height: 1.35; }
  .proof__text span { font-size: var(--fs-small); color: var(--muted); }
  .proof__item:hover strong { text-decoration: underline; text-underline-offset: 4px; }
  @media (min-width: 48rem) {
    .proof__list { grid-template-columns: repeat(3, 1fr); }
    .proof li + li .proof__item { border-top: 0; border-left: 1px solid var(--border); padding-left: var(--space-5); }
  }
</style>
