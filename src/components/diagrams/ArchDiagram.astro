---
export interface Node { x: number; y: number; w: number; h: number; t1: string; t2?: string }
export interface Group { x: number; y: number; w: number; h: number; label: string }
export interface Label { x: number; y: number; text: string }
interface Props {
  width: number;
  height: number;
  title: string;
  nodes: Node[];
  edges: string[];
  groups?: Group[];
  labels?: Label[];
  description: string;
}
const { width, height, title, nodes, edges, groups = [], labels = [], description } = Astro.props;
---

<figure class="arch">
  <div class="arch__scroll" tabindex="0" role="group" aria-label={`${title} (scrolls horizontally on small screens)`}>
    <svg viewBox={`0 0 ${width} ${height}`} width={width} height={height} role="img" aria-label={description}>
      <defs>
        <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 10 5 0 10z" fill="currentColor"></path>
        </marker>
      </defs>
      {groups.map((g) => (
        <g>
          <rect class="group" x={g.x} y={g.y} width={g.w} height={g.h} rx="10"></rect>
          <text class="glabel" x={g.x + 16} y={g.y + 22}>{g.label}</text>
        </g>
      ))}
      {labels.map((l) => <text class="lane" x={l.x} y={l.y}>{l.text}</text>)}
      {edges.map((d) => <path class="edge" d={d} marker-end="url(#arrow)"></path>)}
      {nodes.map((n) => (
        <g>
          <rect class="node" x={n.x} y={n.y} width={n.w} height={n.h} rx="8"></rect>
          <text class="t1" x={n.x + n.w / 2} y={n.y + n.h / 2 + (n.t2 ? -2 : 5)} text-anchor="middle">{n.t1}</text>
          {n.t2 && <text class="t2" x={n.x + n.w / 2} y={n.y + n.h / 2 + 15} text-anchor="middle">{n.t2}</text>}
        </g>
      ))}
    </svg>
  </div>
  <figcaption>{description}</figcaption>
</figure>

<style>
  .arch { margin-block: var(--space-5); }
  .arch__scroll { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); padding: var(--space-3); color: var(--subtle); }
  svg { max-width: none; height: auto; }
  .group { fill: none; stroke: var(--border); stroke-dasharray: 4 4; }
  .node { fill: var(--bg); stroke: var(--border); }
  .edge { fill: none; stroke: currentColor; stroke-width: 1.25; }
  text { font-family: var(--font-mono); fill: var(--ink); }
  .t1 { font-size: 13px; font-weight: 500; }
  .t2 { font-size: 12px; fill: var(--muted); }
  .glabel, .lane { font-size: 12px; fill: var(--subtle); letter-spacing: 0.04em; }
  figcaption { margin-top: var(--space-2); font-size: var(--fs-small); color: var(--subtle); max-width: var(--measure); }
</style>
