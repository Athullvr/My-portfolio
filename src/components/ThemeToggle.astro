---
---

<button class="theme-toggle" type="button" aria-label="Toggle color theme" data-theme-toggle>
  <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
    <circle cx="9" cy="9" r="7" fill="none" stroke="currentColor" stroke-width="1.5" />
    <path d="M9 2a7 7 0 0 1 0 14z" fill="currentColor" />
  </svg>
</button>

<script>
  document.querySelector<HTMLButtonElement>('[data-theme-toggle]')?.addEventListener('click', () => {
    const root = document.documentElement;
    const dark = (root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')) === 'dark';
    const next = dark ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .theme-toggle {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.75rem; height: 2.75rem; padding: 0;
    background: transparent; border: 0; border-radius: 8px;
    color: var(--muted); cursor: pointer;
  }
  @media (hover: hover) { .theme-toggle:hover { color: var(--ink); } }
</style>
