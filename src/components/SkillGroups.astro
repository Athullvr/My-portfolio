---
import { skills } from '../data/profile';
---

<section class="section" id="skills" aria-labelledby="skills-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="label">Skills</p>
      <h2 id="skills-title">What I use, and where</h2>
    </div>
    <div class="groups">
      {skills.map((g) => (
        <div class="group">
          <h3 class="label">{g.group}</h3>
          <ul>
            {g.items.map((i) => <li>{i.href ? <a href={i.href}>{i.name}</a> : <span>{i.name}</span>}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .groups { display: grid; gap: var(--space-6); }
  .group h3 { margin-bottom: var(--space-3); }
  .group ul { list-style: none; padding: 0; display: grid; gap: var(--space-2); }
  .group li { font-size: var(--fs-small); color: var(--ink); }
  .group a { color: var(--ink); text-decoration-color: var(--border); text-underline-offset: 4px; }
  .group a:hover { color: var(--accent); text-decoration-color: currentColor; }
  @media (min-width: 40rem) { .groups { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .groups { grid-template-columns: repeat(4, 1fr); } }
</style>
