---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import ProofStrip from '../components/ProofStrip.astro';
import WorkGrid from '../components/WorkGrid.astro';
import About from '../components/About.astro';
import ExperienceList from '../components/ExperienceList.astro';
import SkillGroups from '../components/SkillGroups.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Nav />
  <main id="main">
    <Hero />
    <ProofStrip />
    <WorkGrid />
    <About />
    <ExperienceList />
    <SkillGroups />
    <Contact />
  </main>
  <Footer />
</Base>
